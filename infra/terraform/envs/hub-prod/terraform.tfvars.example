# Target AWS account: Control-Prod (Launchpad Control Plane).
# Account ID: 762794225431 — see docs/ACCOUNTS_AND_ROLES.md
# Account inventory: docs/ACCOUNTS_AND_ROLES.md

aws_region                = "us-east-1"
name_prefix               = "mlp-hub-prod"
vpc_id                    = "vpc-xxxxxxxx"
subnet_ids                = ["subnet-aaa", "subnet-bbb"]
data_bucket_name          = "mlp-prod-shared-data"
prod_data_bucket_name     = "mlp-prod-model-data"
dev_artifacts_bucket_name = "mlp-prod-build-artifacts"
artifacts_bucket_name     = "mlp-prod-model-artifacts"
athena_spill_bucket_name  = "mlp-prod-athena-spill"
model_package_group_name  = "ModelCreditRisk"

# Client-managed IAM role ARNs (see docs/CLIENT_MANAGED_IAM_ROLES.md)
pipeline_role_arn              = "arn:aws:iam::762794225431:role/mlp-sagemaker-pipeline"
training_role_arn              = "arn:aws:iam::762794225431:role/mlp-sagemaker-training"
inference_role_arn             = "arn:aws:iam::762794225431:role/mlp-sagemaker-inference"
governance_lambda_role_arn     = "arn:aws:iam::762794225431:role/mlp-governance-lambda"
stage_export_lambda_role_arn   = "arn:aws:iam::762794225431:role/mlp-governance-export"
promote_lambda_role_arn        = "arn:aws:iam::762794225431:role/mlp-promote-model"
registration_lambda_role_arn   = "arn:aws:iam::762794225431:role/mlp-register-candidate"
approval_lambda_role_arn       = "arn:aws:iam::762794225431:role/mlp-approval-api"
authorizer_lambda_role_arn     = "arn:aws:iam::762794225431:role/mlp-okta-authorizer"
source_registry_read_role_arn  = "arn:aws:iam::848973819860:role/mlp-registry-read"

# Design v7
okta_issuer            = "https://REPLACE.okta.com/oauth2/REPLACE_SERVER_ID"
okta_audience          = "api://ml-platform-management"
model_ids              = ["credit-risk"]
deployment_account_ids = ["259822548263"] # BU Prod (LIVE)
