aws_region                = "us-east-1"
name_prefix               = "mlp-hub-prod"
vpc_id                    = "vpc-xxxxxxxx"
subnet_ids                = ["subnet-aaa", "subnet-bbb"]
data_bucket_name          = "mlp-prod-shared-data"
prod_data_bucket_name     = "mlp-prod-model-data"
dev_artifacts_bucket_name = "mlp-prod-build-artifacts"
artifacts_bucket_name     = "mlp-prod-model-artifacts"
athena_spill_bucket_name  = "mlp-prod-athena-spill"
endpoint_name             = "credit-risk"
model_package_group_name  = "ModelCreditRisk"

# Client-managed IAM role ARNs (see docs/CLIENT_MANAGED_IAM_ROLES.md)
pipeline_role_arn              = "arn:aws:iam::ACCOUNT_ID:role/mlp-sagemaker-pipeline"
training_role_arn              = "arn:aws:iam::ACCOUNT_ID:role/mlp-sagemaker-training"
inference_role_arn             = "arn:aws:iam::ACCOUNT_ID:role/mlp-sagemaker-inference"
governance_lambda_role_arn     = "arn:aws:iam::ACCOUNT_ID:role/mlp-governance-lambda"
stage_export_lambda_role_arn   = "arn:aws:iam::ACCOUNT_ID:role/mlp-governance-export"
step_functions_role_arn        = "arn:aws:iam::ACCOUNT_ID:role/mlp-pipeline-trigger"
promote_lambda_role_arn        = "arn:aws:iam::ACCOUNT_ID:role/mlp-promote-model"
invoke_lambda_role_arn         = "arn:aws:iam::ACCOUNT_ID:role/mlp-invoke-endpoint"
apigateway_cloudwatch_role_arn = "arn:aws:iam::ACCOUNT_ID:role/mlp-apigw-cloudwatch"
